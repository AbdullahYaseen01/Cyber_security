# ─── Supabase PostgreSQL (required for login) ───
# From Supabase Dashboard → Project Settings → Database
# Runtime (Next.js / Prisma Client): Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1"
# Migrations/seed only (prisma db push, npm run db:setup): direct or session, port 5432
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Note: .env.local overrides .env — keep DATABASE_URL on the pooler (6543), not db.*:5432

# ─── Supabase API (realtime scan updates) ───
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Auth (NextAuth.js v5) ───
AUTH_SECRET="your-secret-key-min-32-characters-long"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Stripe (optional) ───
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_MONTHLY="price_..."
STRIPE_STARTER_ANNUAL="price_..."
STRIPE_PRO_MONTHLY="price_..."
STRIPE_PRO_ANNUAL="price_..."
STRIPE_BUSINESS_MONTHLY="price_..."
STRIPE_BUSINESS_ANNUAL="price_..."
STRIPE_ENTERPRISE_MONTHLY="price_..."
STRIPE_ENTERPRISE_ANNUAL="price_..."

# ─── OpenAI (optional) ───
OPENAI_API_KEY="sk-..."

# ─── Email reports (optional — Resend) ───
# Without RESEND_API_KEY, reports are still saved in-app + notifications.
RESEND_API_KEY=""
EMAIL_FROM="QuantumShield <onboarding@resend.dev>"

# ─── App URLs ───
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── One-time DB setup on Vercel (optional) ───
SETUP_SECRET="change-me-before-running-setup"

# ─── Scanner backend (optional, local only) ───
NEXT_PUBLIC_SCANNER_API_URL="http://127.0.0.1:8080"
