generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  role          UserRole  @default(ANALYST)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orgs          OrgMember[]
  ownedOrgs     Organization[] @relation("OrgOwner")
  scans         Scan[]
  findings      Finding[]
  reports       Report[]
  apiKeys       ApiKey[]
  notifications Notification[]
}

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  timezone  String   @default("UTC")
  dateFormat String  @default("MMM d, yyyy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner             User               @relation("OrgOwner", fields: [ownerId], references: [id])
  members           OrgMember[]
  subscription      Subscription?
  domains           Domain[]
  scans             Scan[]
  findings          Finding[]
  apiEndpoints      ApiEndpoint[]
  agents            Agent[]
  cloudAccounts     CloudAccount[]
  phishingCampaigns PhishingCampaign[]
  darkWebAlerts     DarkWebAlert[]
  complianceTasks   ComplianceTask[]
  reports           Report[]
  webhooks          Webhook[]
  apiKeys           ApiKey[]
}

model OrgMember {
  id       String   @id @default(cuid())
  orgId    String
  userId   String
  role     UserRole @default(VIEWER)
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Subscription {
  id                   String             @id @default(cuid())
  orgId                String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  tier                 SubscriptionTier   @default(STARTER)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  scansUsedThisMonth   Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  PAST_DUE
  UNPAID
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

model Domain {
  id                String    @id @default(cuid())
  orgId             String
  name              String
  verified          Boolean   @default(false)
  verificationToken String    @unique @default(uuid())
  lastScannedAt     DateTime?
  securityScore     Int       @default(0)
  grade             String    @default("F")
  createdAt         DateTime  @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scans        Scan[]
  findings     Finding[]
  apiEndpoints ApiEndpoint[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Scan {
  id            String     @id @default(cuid())
  orgId         String
  domainId      String
  userId        String
  mode          ScanMode
  status        ScanStatus @default(PENDING)
  progress      Int        @default(0)
  currentPhase  String?
  totalPhases   Int        @default(13)
  findingsCount Int        @default(0)
  criticalCount Int        @default(0)
  highCount     Int        @default(0)
  mediumCount   Int        @default(0)
  lowCount      Int        @default(0)
  infoCount     Int        @default(0)
  fuzzProgress  Int        @default(0)
  fuzzTotal     Int        @default(1000000)
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  config        Json?
  results       Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domain   Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])
  findings Finding[]

  @@index([orgId])
  @@index([domainId])
  @@index([userId])
}

enum ScanMode {
  LIGHTNING
  STANDARD
  MEGA
  SUPER
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

model Finding {
  id                  String        @id @default(cuid())
  orgId               String
  domainId            String
  scanId              String
  userId              String
  title               String
  description         String        @db.Text
  severity            Severity
  status              FindingStatus @default(OPEN)
  confidence          Float         @default(0.0)
  category            String
  cweId               String?
  cvssScore           Float?
  url                 String
  parameter           String?
  method              String        @default("GET")
  payload             String?       @db.Text
  request             String?       @db.Text
  response            String?       @db.Text
  remediation         String?       @db.Text
  verified            Boolean       @default(false)
  isFalsePositive     Boolean       @default(false)
  falsePositiveReason String?
  bugBountyReport     String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domain Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  scan   Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([scanId])
  @@index([severity])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
}

model ApiEndpoint {
  id           String    @id @default(cuid())
  orgId        String
  domainId     String
  path         String
  method       String
  authType     String?
  riskScore    Int       @default(0)
  lastTestedAt DateTime?
  findings     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domain Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([domainId])
}

model Agent {
  id            String      @id @default(cuid())
  orgId         String
  name          String
  hostname      String
  os            String
  version       String
  status        AgentStatus @default(OFFLINE)
  lastHeartbeat DateTime?
  ipAddress     String?
  installToken  String      @unique @default(cuid())
  config        Json?
  alerts        Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum AgentStatus {
  ONLINE
  OFFLINE
  WARNING
  QUARANTINED
}

model CloudAccount {
  id             String        @id @default(cuid())
  orgId          String
  provider       CloudProvider
  name           String
  accountId      String
  credentials    Json?
  status         String        @default("CONNECTED")
  lastScannedAt  DateTime?
  findings       Json?
  misconfigCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum CloudProvider {
  AWS
  AZURE
  GCP
}

model PhishingCampaign {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  template        String
  status          String    @default("DRAFT")
  targetCount     Int       @default(0)
  sentCount       Int       @default(0)
  openCount       Int       @default(0)
  clickCount      Int       @default(0)
  credentialCount Int       @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  completedAt     DateTime?
  targets         Json?
  config          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model DarkWebAlert {
  id             String   @id @default(cuid())
  orgId          String
  type           String
  severity       Severity
  title          String
  description    String   @db.Text
  source         String?
  affectedEmails Json?
  status         String   @default("NEW")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model ComplianceTask {
  id            String     @id @default(cuid())
  orgId         String
  framework     String
  controlId     String
  controlName   String
  description   String     @db.Text
  status        TaskStatus @default(NOT_STARTED)
  assignedTo    String?
  dueDate       DateTime?
  completedAt   DateTime?
  evidenceUrl   String?
  autoCompleted Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([framework])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  FAILED
}

model Report {
  id           String     @id @default(cuid())
  orgId        String
  userId       String
  title        String
  type         ReportType
  content      String     @db.Text
  format       String     @default("HTML")
  status       String     @default("GENERATED")
  scheduledFor DateTime?
  sentAt       DateTime?
  config       Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId])
}

enum ReportType {
  EXECUTIVE_SUMMARY
  TECHNICAL_VULNERABILITY
  COMPLIANCE_STATUS
  API_SECURITY
  CLOUD_MISCONFIG
  AGENT_HEALTH
  PHISHING_RESULTS
  DARK_WEB_EXPOSURE
  BUG_BOUNTY
  PENTEST
  INCIDENT_RESPONSE
}

model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  userId      String
  name        String
  keyHash     String
  keyPrefix   String
  permissions Json
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Webhook {
  id              String    @id @default(cuid())
  orgId           String
  url             String
  secret          String
  events          Json
  active          Boolean   @default(true)
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model DarkWebMonitor {
  id               String   @id @default(cuid())
  orgId            String   @unique
  monitoredDomains Json     @default("[]")
  monitoredEmails  Json     @default("[]")
  keywords         Json     @default("[]")
  alertThreshold   Severity @default(HIGH)
  emailEnabled     Boolean  @default(true)
  slackWebhook     String?
  teamsWebhook     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
